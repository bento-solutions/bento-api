# Dev environment .env  ->  copy to /srv/bento/apps/crm-backend-dev/.env
#
# Used by docker-compose.dev.yml (crm-backend-dev, crm-postgres-dev,
# crm-redis-dev). Keep the secrets DIFFERENT from production -- this stack has its
# own isolated Postgres/Redis volumes and must not reuse prod credentials.

# Database Configuration (container-internal host/port; volume is separate from prod)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=crm_db
DB_USER=postgres
DB_PASSWORD=change-me-dev-db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-dev-redis

# JWT Configuration -- must be at least 32 characters, and its own value (not prod's)
JWT_SECRET=change-me-dev-jwt-secret-at-least-32-characters-long
JWT_ACCESS_TOKEN_EXPIRY=900000
JWT_REFRESH_TOKEN_EXPIRY=2592000000

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# CORS -- the dev frontend origin only
# https://localhost and capacitor://localhost are the Android and iOS mobile app.
CORS_ALLOWED_ORIGINS=https://dev.crmbento.com,https://localhost,capacitor://localhost

# Invitation accept URL -- the dev frontend, not the API
INVITATION_ACCEPT_URL=https://dev.crmbento.com/invite/accept
INVITATION_EXPIRY_DAYS=7

# Mail -- left disabled in dev so invites are logged, never sent to real people.
# Set MAIL_ENABLED=true and fill MAIL_USERNAME/MAIL_PASSWORD only to test delivery.
MAIL_ENABLED=false
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SSL=true
MAIL_STARTTLS=false
MAIL_FROM=no-reply@crmbento.com
MAIL_FROM_NAME=Bento CRM (dev)

# WhatsApp (optional in dev; signature checking is skipped when unset)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=bento-verify-dev

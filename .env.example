# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=crm_db
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
# REDIS_PASSWORD is required: it is passed to redis-server --requirepass.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# pgAdmin Configuration
# Both are required. pgAdmin binds to 127.0.0.1 only, so reach it with:
#   ssh -L 5050:127.0.0.1:5050 bento-prod
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production-minimum-32-characters
JWT_ACCESS_TOKEN_EXPIRY=900000
JWT_REFRESH_TOKEN_EXPIRY=2592000000

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# CORS Configuration
# https://localhost and capacitor://localhost are the Android and iOS mobile app.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:3000,https://localhost,capacitor://localhost

# Google OAuth (Phase 2+)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Pay-by-Link, shared files and the client portal open on the frontend.
PAYMENTS_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# The test gateway settles invoices without a charge, through a public endpoint. Local use only:
# leave it false everywhere else. Stripe needs both keys below.
PAYMENTS_MOCK_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI: Claude reads supplier invoices and bank statements and powers the assistant. Empty: off.
ANTHROPIC_API_KEY=

# Documents inbox: empty INBOUND_WEBHOOK_SECRET turns the email webhook off, and empty
# INBOUND_TRUSTED_AUTHSERV_IDS means nothing is booked automatically (see application.yml).
INBOUND_WEBHOOK_SECRET=
INBOUND_TRUSTED_AUTHSERV_IDS=

# Document storage: local (./uploads) or s3 for an S3-compatible bucket (S3_*, see application.yml).
STORAGE_TYPE=local

# Push notifications to the mobile app: put the Firebase service-account key in ./secrets and
# point at it as seen from the container, e.g. /data/secrets/fcm.json. Empty: push is off.
FCM_SERVICE_ACCOUNT_FILE=
